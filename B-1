#include <iostream>
using namespace std;

int main() {
    int numeros[5];

    for (int i = 0; i < 5; i++) {
        cout << "Ingrese el número " << i + 1 << ": ";
        cin >> numeros[i];
    }

    cout << "\nNúmeros ingresados:\n";
    for (int i = 0; i < 5; i++) {
        cout << numeros[i] << " ";
    }
    cout << endl;

    return 0;
}
