#include <iostream>
using namespace std;

int main() {
    int valores[7] = {4, 6, 9, 3, 8, 2, 9};

    valores[5] = valores[5] - 2;

    int aux = valores[3];
    valores[3] = valores[6];
    valores[6] = aux;

    cout << "Vector final:\n";
    for (int i = 0; i < 7; i++) {
        cout << valores[i] << " ";
    }
    cout << endl;

    return 0;
}
