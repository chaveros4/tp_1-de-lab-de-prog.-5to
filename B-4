#include <iostream>
using namespace std;

int main() {
    int datos[8] = {8, 9, 3, 6, 7, 1, 4, 2};
    int numero;
    bool encontrado = false;

    cout << "Ingrese un número a buscar: ";
    cin >> numero;

    for (int i = 0; i < 8; i++) {
        if (datos[i] == numero) {
            cout << "El número se encuentra en la posición " << i << endl;
            encontrado = true;
            break;
        }
    }

    if (!encontrado) {
        cout << "El número no existe." << endl;
    }

    return 0;
}
